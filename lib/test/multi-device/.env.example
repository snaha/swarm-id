# Multi-device integration suite — copy to `.env` (gitignored) and fill in.
# Run: pnpm --filter @snaha/swarm-id test:multi-device
#
# SECURITY: SIGNER_KEY is a real PRIVATE KEY (the postage batch owner). Keep the
# `.env` local; treat the batch/key as disposable after testing. Never commit it.

# Bee node / gateway to publish through. Defaults to the public gateway.
BEE_URL=https://api.gateway.ethswarm.org/

# Postage batch usable on BEE_URL's chain (REQUIRED).
BATCH_ID=

# The batch owner's private key — signs the stamps (REQUIRED).
SIGNER_KEY=

# Batch depth / amount (used to build the test stamps).
DEPTH=21
AMOUNT=0

# Timing knobs (gateway-sized defaults). Lower them against a fast local node.
# Space simultaneous device announces beyond the gateway's ~50s negative-cache.
PROP_DELAY_MS=70000
RESTORE_POLL_TRIES=24
RESTORE_POLL_DELAY_MS=8000

# Partition-contention knobs (kept tight so acquires finish within the 30s TTL).
IDLE_MS=38000
ACQUIRE_GAP_MS=2000
INTENT_WINDOW_MS=2000
GUARD_MS=1000

# Set VERBOSE=1 to keep the library's raw [module] tracing in the output.
# VERBOSE=1
