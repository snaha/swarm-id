{
  "name": "@snaha/swarm-id",
  "version": "0.1.3",
  "type": "module",
  "description": "Swarm ID library for authentication and Bee API operations",
  "main": "dist/swarm-id.esm.js",
  "module": "dist/swarm-id.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/swarm-id.esm.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:multi-device": "vitest run --config vitest.multi-device.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:all": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "keywords": [
    "swarm",
    "identity",
    "authentication",
    "bee",
    "web3"
  ],
  "author": "snaha",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/snaha/swarm-id"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ethersphere/bee-js": "^11.1.1",
    "cafe-utility": "33.3.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "@vitest/ui": "^4.0.16",
    "esbuild": "^0.28.0",
    "eslint": "9.39.1",
    "eslint-plugin-notice": "^1.0.0",
    "prettier": "3.7.3",
    "rollup": "4.53.3",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "vitest": "4.0.14"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "11.x"
  }
}
