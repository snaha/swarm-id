{
  "name": "@swarm-id/demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Swarm ID demo application",
  "scripts": {
    "dev": "vite dev --port 3500",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:all": "pnpm lint && pnpm check && pnpm knip && pnpm test",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write . && eslint . --fix",
    "knip": "knip",
    "clean": "rm -rf build .svelte-kit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ethersphere/bee-js": "13.0.0",
    "@snaha/swarm-id": "workspace:*",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@swarm-id/eslint-rules": "workspace:*",
    "@tailwindcss/vite": "4.3.0",
    "clsx": "2.1.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "16.5.0",
    "knip": "5.88.1",
    "prettier": "3.7.3",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.57.3",
    "svelte-check": "4.3.4",
    "svelte-eslint-parser": "1.8.1",
    "tailwind-merge": "3.0.2",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.17",
    "pnpm": "11.x"
  }
}
