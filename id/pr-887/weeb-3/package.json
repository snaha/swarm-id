{
  "name": "@lat-murmeldjur/weeb_3",
  "type": "module",
  "description": "A Swarm client for browsers",
  "version": "0.0.354001",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lat-murmeldjur/weeb-3.git"
  },
  "main": "./weeb_3.js",
  "homepage": "https://github.com/lat-murmeldjur/weeb-3#readme",
  "types": "./weeb_3.d.ts",
  "module": "./weeb_3.js",
  "bugs": {
    "url": "https://github.com/lat-murmeldjur/weeb-3/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "snippets",
    "weeb_3.d.ts",
    "weeb_3.js",
    "weeb_3_bg.wasm",
    "weeb_3_bg.wasm.d.ts",
    "service.js",
    "worker.js"
  ],
  "sideEffects": [
    "./snippets/**/*"
  ],
  "keywords": [
    "bee",
    "browser",
    "swarm",
    "wasm",
    "webassembly"
  ],
  "exports": {
    ".": {
      "types": "./weeb_3.d.ts",
      "import": "./weeb_3.js",
      "default": "./weeb_3.js"
    },
    "./service.js": {
      "default": "./service.js"
    },
    "./worker.js": {
      "default": "./worker.js"
    }
  },
  "dependencies": {
    "hls.js": "^1.6.2"
  }
}
