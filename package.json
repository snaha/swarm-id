{
  "name": "swarm-id",
  "version": "1.0.0",
  "private": true,
  "description": "Swarm Identity Management - Monorepo",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:legacy",
    "dev:new": "concurrently -n lib,ui,demo -c yellow,blue,green \"pnpm dev:lib\" \"pnpm dev:ui\" \"pnpm dev:demo:new\"",
    "dev:legacy": "concurrently -n lib,swarm-ui,demo -c yellow,blue,green \"pnpm dev:lib\" \"pnpm dev:swarm-ui\" \"pnpm dev:demo:legacy\"",
    "dev:bee": "bee-compose start --full 4 --no-detach",
    "dev:bee:detach": "bee-compose start --full 4",
    "dev:bee:stop": "bee-compose stop",
    "dev:bee:logs": "bee-compose logs queen --follow",
    "dev:bee:fresh": "bee-compose start --full 4 --fresh",
    "dev:demo": "pnpm --filter @swarm-id/demo dev",
    "dev:demo:new": "PUBLIC_ID_DOMAIN=http://localhost:5500 pnpm dev:demo",
    "dev:demo:legacy": "PUBLIC_ID_DOMAIN=http://localhost:5510 pnpm dev:demo",
    "dev:lib": "pnpm --filter @snaha/swarm-id build:watch",
    "dev:swarm-ui": "pnpm --filter swarm-identity dev",
    "dev:ui": "pnpm --filter @swarm-id/ui dev",
    "dev:docs": "pnpm --filter @swarm-id/docs dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:lib": "pnpm --filter @snaha/swarm-id build",
    "build:demo": "pnpm --filter @swarm-id/demo build",
    "build:swarm-ui": "pnpm --filter swarm-identity build",
    "build:ui": "pnpm --filter @swarm-id/ui build",
    "build:swarm-demo": "pnpm build:lib && pnpm build:demo",
    "build:swarm-id": "pnpm build:lib && pnpm build:swarm-ui && rm -rf swarm-id-build && cp -r swarm-ui/build swarm-id-build && cp -r lib/dist swarm-id-build/lib",
    "build:docs": "pnpm --filter @swarm-id/docs build",
    "preview:docs": "pnpm --filter @swarm-id/docs preview",
    "clean": "pnpm -r clean && rm -rf swarm-id-build demo/build",
    "install:all": "pnpm install",
    "check:all": "pnpm --filter @snaha/swarm-id check:all && pnpm --filter swarm-identity check:all && pnpm --filter @swarm-id/ui check:all && pnpm --filter @swarm-id/demo check:all",
    "format:all": "pnpm --filter @snaha/swarm-id format && pnpm --filter swarm-identity format && pnpm --filter @swarm-id/ui format && pnpm --filter @swarm-id/demo format && pnpm --filter @swarm-id/docs format",
    "format:lib": "pnpm --filter @snaha/swarm-id format"
  },
  "devDependencies": {
    "@snaha/bee-compose": "^0.1.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "3.4.0",
    "serve": "^14.2.4"
  },
  "keywords": [
    "swarm",
    "identity",
    "authentication",
    "web3",
    "monorepo"
  ],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22",
    "pnpm": "11.x"
  }
}
