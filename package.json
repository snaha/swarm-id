{
  "name": "swarm-id",
  "version": "1.0.0",
  "private": true,
  "description": "Swarm Identity Management - Monorepo",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,demo,bus -c blue,green,magenta \"pnpm dev:ui\" \"pnpm dev:demo\" \"pnpm dev:signaling\"",
    "dev:signaling": "PORT=5520 pnpm --filter @swarm-id/signaling start",
    "dev:local": "pnpm dev:cluster:start && pnpm dev:source-chain:detach && pnpm -s dev:local:run",
    "dev:local:fresh": "pnpm dev:source-chain:stop && pnpm dev:cluster:start --fresh && pnpm dev:source-chain:detach && pnpm -s dev:local:run",
    "dev:local:stop": "pnpm dev:source-chain:stop; pnpm dev:chain:stop",
    "dev:local:run": "concurrently -n solver,ui,demo,bus -c yellow,blue,green,magenta \"pnpm dev:solver\" \"pnpm dev:ui\" \"pnpm dev:demo\" \"pnpm dev:signaling\"",
    "dev:ui": "pnpm --filter @swarm-id/ui dev",
    "dev:demo": "PUBLIC_ID_DOMAIN=http://localhost:5500 pnpm --filter @swarm-id/demo exec vite dev --port 3500",
    "dev:lib": "pnpm --filter @snaha/swarm-id build:watch",
    "dev:docs": "pnpm --filter @swarm-id/docs dev",
    "dev:solver": "pnpm --filter @swarm-id/multichain solver",
    "dev:cluster": "bee-compose",
    "dev:cluster:start": "bee-compose start --full 4",
    "dev:chain": "bee-compose start --without-bees --no-detach",
    "dev:chain:detach": "bee-compose start --without-bees",
    "dev:chain:stop": "bee-compose stop",
    "dev:cluster:logs": "bee-compose logs queen --follow",
    "dev:source-chain": "docker run --rm --name source-chain -p 31337:8545 --entrypoint anvil ghcr.io/foundry-rs/foundry:v1.8.1 --chain-id 31337 --host 0.0.0.0 --port 8545",
    "dev:source-chain:detach": "docker ps -q -f name=^source-chain$ | grep -q . || pnpm -s dev:source-chain:run",
    "dev:source-chain:run": "docker run -d --rm --name source-chain -p 31337:8545 --entrypoint anvil ghcr.io/foundry-rs/foundry:v1.8.1 --chain-id 31337 --host 0.0.0.0 --port 8545",
    "dev:source-chain:stop": "docker rm -f source-chain >/dev/null 2>&1 || true",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:lib": "pnpm --filter @snaha/swarm-id build",
    "build:demo": "pnpm --filter @swarm-id/demo build",
    "build:ui": "pnpm --filter @swarm-id/ui build",
    "build:swarm-demo": "pnpm build:lib && pnpm build:demo",
    "build:docs": "pnpm --filter @swarm-id/docs build",
    "preview:docs": "pnpm --filter @swarm-id/docs preview",
    "clean": "pnpm -r run clean",
    "install:all": "pnpm install",
    "test:live": "pnpm --filter @snaha/swarm-id test:live",
    "test:fork": "pnpm --filter @swarm-id/multichain test:fork",
    "check:all": "pnpm format:check && pnpm --filter @snaha/swarm-id check:all && pnpm --filter @swarm-id/multichain check:all && pnpm --filter @swarm-id/signaling check:all && pnpm --filter @swarm-id/ui check:all && pnpm --filter @swarm-id/demo check:all",
    "format": "git ls-files -z ':(exclude)CLAUDE.md' ':(exclude)*/CLAUDE.md' | xargs -0 prettier --write --ignore-unknown",
    "format:check": "git ls-files -z ':(exclude)CLAUDE.md' ':(exclude)*/CLAUDE.md' | xargs -0 prettier --check --ignore-unknown",
    "format:all": "pnpm --filter @snaha/swarm-id format && pnpm --filter @swarm-id/multichain format && pnpm --filter @swarm-id/ui format && pnpm --filter @swarm-id/demo format && pnpm --filter @swarm-id/docs format && prettier --write .",
    "format:lib": "pnpm --filter @snaha/swarm-id format"
  },
  "devDependencies": {
    "@snaha/bee-compose": "^0.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "3.4.0",
    "serve": "^14.2.4"
  },
  "keywords": [
    "swarm",
    "identity",
    "authentication",
    "web3",
    "monorepo"
  ],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22",
    "pnpm": "11.x"
  }
}
