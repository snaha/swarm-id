{
  "name": "swarm-id",
  "version": "1.0.0",
  "private": true,
  "description": "Swarm Identity Management - Monorepo",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,demo -c blue,green \"pnpm dev:ui\" \"pnpm dev:demo\"",
    "dev:local": "pnpm -s dev:cluster start --full 4 && pnpm dev:source-chain:detach && pnpm -s dev:local:run",
    "dev:local:fresh": "pnpm dev:source-chain:stop && pnpm -s dev:cluster start --full 4 --fresh && pnpm dev:source-chain:detach && pnpm -s dev:local:run",
    "dev:local:stop": "pnpm dev:source-chain:stop; pnpm -s dev:cluster stop",
    "dev:local:run": "concurrently -n solver,ui,demo -c yellow,blue,green \"pnpm dev:solver\" \"pnpm dev:ui\" \"pnpm dev:demo\"",
    "dev:ui": "pnpm --filter @swarm-id/ui dev",
    "dev:demo": "PUBLIC_ID_DOMAIN=http://localhost:5500 pnpm --filter @swarm-id/demo exec vite dev --port 3500",
    "dev:lib": "pnpm --filter @snaha/swarm-id build:watch",
    "dev:docs": "pnpm --filter @swarm-id/docs dev",
    "dev:solver": "pnpm --filter @swarm-id/multichain solver",
    "dev:cluster:build": "pnpm --dir vendor/bee-compose --ignore-workspace install --frozen-lockfile && pnpm --dir vendor/bee-compose --ignore-workspace build",
    "dev:cluster": "[ -f vendor/bee-compose/dist/cli.js ] || pnpm -s dev:cluster:build && node vendor/bee-compose/bin/bee-compose.js",
    "dev:chain": "docker run --rm --name gnosis-chain -p 8545:8545 -v \"$PWD/vendor/bee-compose/blockchain:/state:ro\" --entrypoint anvil ghcr.io/foundry-rs/foundry:stable --load-state /state/state.gnosis.json --chain-id 100 --host 0.0.0.0 --port 8545",
    "dev:chain:detach": "docker ps -q -f name=^gnosis-chain$ | grep -q . || pnpm -s dev:chain:run",
    "dev:chain:run": "docker run -d --rm --name gnosis-chain -p 8545:8545 -v \"$PWD/vendor/bee-compose/blockchain:/state:ro\" --entrypoint anvil ghcr.io/foundry-rs/foundry:stable --load-state /state/state.gnosis.json --chain-id 100 --host 0.0.0.0 --port 8545",
    "dev:chain:stop": "docker rm -f gnosis-chain >/dev/null 2>&1 || true",
    "dev:source-chain": "docker run --rm --name source-chain -p 31337:8545 --entrypoint anvil ghcr.io/foundry-rs/foundry:stable --chain-id 31337 --host 0.0.0.0 --port 8545",
    "dev:source-chain:detach": "docker ps -q -f name=^source-chain$ | grep -q . || pnpm -s dev:source-chain:run",
    "dev:source-chain:run": "docker run -d --rm --name source-chain -p 31337:8545 --entrypoint anvil ghcr.io/foundry-rs/foundry:stable --chain-id 31337 --host 0.0.0.0 --port 8545",
    "dev:source-chain:stop": "docker rm -f source-chain >/dev/null 2>&1 || true",
    "dev:cluster:logs": "pnpm -s dev:cluster logs queen --follow",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:lib": "pnpm --filter @snaha/swarm-id build",
    "build:demo": "pnpm --filter @swarm-id/demo build",
    "build:ui": "pnpm --filter @swarm-id/ui build",
    "build:swarm-demo": "pnpm build:lib && pnpm build:demo",
    "build:docs": "pnpm --filter @swarm-id/docs build",
    "preview:docs": "pnpm --filter @swarm-id/docs preview",
    "clean": "pnpm -r clean",
    "test:live": "pnpm --filter @snaha/swarm-id test:live",
    "check:all": "pnpm --filter @snaha/swarm-id check:all && pnpm --filter @swarm-id/multichain check:all && pnpm --filter @swarm-id/ui check:all && pnpm --filter @swarm-id/demo check:all",
    "format:all": "pnpm --filter @snaha/swarm-id format && pnpm --filter @swarm-id/multichain format && pnpm --filter @swarm-id/ui format && pnpm --filter @swarm-id/demo format && pnpm --filter @swarm-id/docs format && prettier --write .",
    "format:lib": "pnpm --filter @snaha/swarm-id format",
    "test:fork": "pnpm --filter @swarm-id/multichain test:fork"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "3.4.0",
    "serve": "^14.2.4"
  },
  "keywords": [
    "swarm",
    "identity",
    "authentication",
    "web3",
    "monorepo"
  ],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22",
    "pnpm": "11.x"
  }
}
