{
  "name": "swarm-id",
  "version": "1.0.0",
  "private": true,
  "description": "Swarm Identity Management - Monorepo",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,demo -c blue,green \"pnpm dev:swarm-ui\" \"pnpm dev:demo\"",
    "dev:bee": "bee-compose start --light 1 --no-detach",
    "dev:bee:detach": "bee-compose start --light 1",
    "dev:bee:stop": "bee-compose stop",
    "dev:bee:logs": "bee-compose logs queen --follow",
    "dev:bee:fresh": "bee-compose start --light 1 --fresh --pull",
    "dev:demo": "pnpm --filter @swarm-id/demo dev",
    "dev:lib": "pnpm --filter @snaha/swarm-id build:watch",
    "dev:swarm-ui": "pnpm --filter swarm-identity dev",
    "dev:docs": "pnpm --filter @swarm-id/docs dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:lib": "pnpm --filter @snaha/swarm-id build",
    "build:demo": "pnpm --filter @swarm-id/demo build",
    "build:swarm-ui": "pnpm --filter swarm-identity build",
    "build:swarm-demo": "pnpm build:lib && pnpm build:demo",
    "build:swarm-id": "pnpm build:lib && pnpm build:swarm-ui && rm -rf swarm-id-build && cp -r swarm-ui/build swarm-id-build && cp -r lib/dist swarm-id-build/lib",
    "build:docs": "pnpm --filter @swarm-id/docs build",
    "preview:docs": "pnpm --filter @swarm-id/docs preview",
    "clean": "pnpm -r clean && rm -rf swarm-id-build demo/build",
    "install:all": "pnpm install",
    "check:all": "pnpm --filter @snaha/swarm-id check:all && pnpm --filter swarm-identity check:all && pnpm --filter @swarm-id/demo check:all",
    "format:all": "pnpm --filter @snaha/swarm-id format && pnpm --filter swarm-identity format && pnpm --filter @swarm-id/demo format && pnpm --filter @swarm-id/docs format",
    "format:lib": "pnpm --filter @snaha/swarm-id format"
  },
  "devDependencies": {
    "@snaha/bee-compose": "^0.1.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "serve": "^14.2.4"
  },
  "keywords": [
    "swarm",
    "identity",
    "authentication",
    "web3",
    "monorepo"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ]
  }
}
